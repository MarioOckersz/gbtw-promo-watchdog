# Notification Provider: "callmebot" or "meta"
WHATSAPP_PROVIDER=callmebot

# International format WITHOUT '+' or spaces (e.g., 94771234567)
WHATSAPP_PHONE=

# --- Option A: CallMeBot ---
CALLMEBOT_API_KEY=

# --- Option B: Meta WhatsApp Cloud API ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# --- Scraper & Runtime ---
DISPLAY_TIMEZONE=Asia/Colombo
SQLITE_DB_PATH=./data/seen_coupons.db
REQUEST_TIMEOUT_SEC=15
# Set to true on first run if you want to seed existing posts without flooding WhatsApp
SEED_ONLY=false
