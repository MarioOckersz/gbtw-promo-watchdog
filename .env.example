# Create a bot via @BotFather on Telegram and paste the HTTP API token here
TELEGRAM_BOT_TOKEN=

# Your personal Telegram numeric Chat ID (get it from @userinfobot or /getUpdates)
TELEGRAM_CHAT_ID=

# Number of days of historical codes to send immediately after handshake confirmation
BACKFILL_DAYS=60

# Local timezone for displaying UTC expiration deadlines (e.g., Asia/Colombo, America/New_York, UTC)
DISPLAY_TIMEZONE=Asia/Colombo

# Runtime paths & HTTP timeout
SQLITE_DB_PATH=./data/seen_coupons.db
REQUEST_TIMEOUT_SEC=15